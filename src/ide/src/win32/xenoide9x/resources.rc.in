#include "@CMAKE_CURRENT_SOURCE_DIR@/resource.h"

IDI_APPICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/xenoide.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4",               ID_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y",               ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Find/R&eplace...\tCtrl+H",    ID_EDIT_FIND_REPLACE
        MENUITEM "Go to &File...\tCtrl+P",      ID_EDIT_GOTO_FILE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About",                      ID_HELP_ABOUT
    END
END

IDR_ACCELERATOR ACCELERATORS
BEGIN
    "N",    ID_FILE_NEW,            VIRTKEY, CONTROL
    "O",    ID_FILE_OPEN,    VIRTKEY, CONTROL
    "S",    ID_FILE_SAVE,           VIRTKEY, CONTROL
    VK_F4,  ID_FILE_EXIT,           VIRTKEY, ALT
    "Z",    ID_EDIT_UNDO,           VIRTKEY, CONTROL
    "Y",    ID_EDIT_REDO,           VIRTKEY, CONTROL
    "X",    ID_EDIT_CUT,            VIRTKEY, CONTROL
    "C",    ID_EDIT_COPY,           VIRTKEY, CONTROL
    "V",    ID_EDIT_PASTE,          VIRTKEY, CONTROL
    "H",    ID_EDIT_FIND_REPLACE,   VIRTKEY, CONTROL
    "P",    ID_EDIT_GOTO_FILE,      VIRTKEY, CONTROL
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @XENOIDE_VERSION_MAJOR@,@XENOIDE_VERSION_MINOR@,@XENOIDE_VERSION_REVISION@,0
 PRODUCTVERSION @XENOIDE_VERSION_MAJOR@,@XENOIDE_VERSION_MINOR@,@XENOIDE_VERSION_REVISION@,0
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x00000004L
 FILETYPE       0x00000001L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Xenoide9X - Native Win32 IDE"
            VALUE "FileVersion",      "@XENOIDE_VERSION_MAJOR@.@XENOIDE_VERSION_MINOR@.@XENOIDE_VERSION_REVISION@.0"
            VALUE "InternalName",     "Xenoide9X"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "Xenoide9X.exe"
            VALUE "ProductName",      "Xenoide"
            VALUE "ProductVersion",   "@XENOIDE_VERSION_MAJOR@.@XENOIDE_VERSION_MINOR@.@XENOIDE_VERSION_REVISION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
