# Doxygen configuration template for the XE engine.
#
# Configured via `configure_file()` from the root CMakeLists.txt when the
# engine-wide `XE_DEV_DOCS` option is ON. Variables of the form @VARNAME@
# are substituted by CMake at configure time; everything else is a literal
# Doxygen setting.
#
# Scope: this file is the single source of Doxygen configuration for the
# entire XE codebase. INPUT covers every library under src/ (libxe-app,
# libxe-core, libxe-core-imageloader-lodepng, libxe-core-platform-glfw,
# libxe-geometry, libxe-gl, libxe-imageloader, libxe-math, libxe-scene)
# and the engine tools/applications. EXCLUDE_PATTERNS keeps test code,
# imgui backend bindings and CMake build artifacts out of the output.

PROJECT_NAME           = "XE"
PROJECT_NUMBER         = "@XE_VERSION@"
PROJECT_BRIEF          = "Multiplatform C++17 game engine"

OUTPUT_DIRECTORY       = @CMAKE_BINARY_DIR@/docs

# The whole engine source tree. RECURSIVE picks up every nested header
# directory; EXCLUDE_PATTERNS below trims out per-library test suites and
# the third-party imgui backend bindings.
INPUT                  = @CMAKE_SOURCE_DIR@/src
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.cc *.cxx
STRIP_FROM_PATH        = @CMAKE_SOURCE_DIR@

EXCLUDE_PATTERNS       = */test/* \
                         */tests/* \
                         */unit-test/* \
                         */bindings/* \
                         */build/* \
                         */CMakeFiles/*

# Documentation policy: we explicitly comment what is public, so do NOT
# auto-extract everything. Anything left undocumented after the planned
# Doxygen pass is a bug and should fail the audit.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
# Start permissive; flip to YES once every library has been documented.
WARN_AS_ERROR          = NO

# C++17 source.
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
INLINE_INHERITED_MEMB  = NO
TAB_SIZE               = 4
ALIASES                =

# We want template parameters to show up in declarations.
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_HEADERFILE        = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

# Output format toggles.
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

# XML output is kept so future tooling (Sphinx/Breathe, doxygen2html, etc.)
# can consume the same data without re-running Doxygen.
GENERATE_XML           = YES
XML_OUTPUT             = xml

# libxe-math/Plane.h uses @f$ ... @f$ for the plane equation, so MathJax
# must be on for the formulas to render.
USE_MATHJAX            = YES
MATHJAX_FORMAT         = HTML-CSS

# Source browsing aids.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

# C++17 features that the parser sometimes mis-handles.
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
IDL_PROPERTY_SUPPORT   = NO

# Dot graphs are nice but require Graphviz; gate behind whatever the build
# environment provides. Leaving on by default and letting Doxygen warn is
# the simplest path.
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

QUIET                  = NO
