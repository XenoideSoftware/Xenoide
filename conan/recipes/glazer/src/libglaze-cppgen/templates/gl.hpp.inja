namespace {{ api }} {

// ── ArrayView<T>: lightweight contiguous-span view used by upload overloads ──
template <typename T>
struct ArrayView {
    const T *ptr;
    std::size_t count;
    constexpr ArrayView() noexcept : ptr(nullptr), count(0) {}
    constexpr ArrayView(const T *p, std::size_t n) noexcept : ptr(p), count(n) {}
    template <std::size_t N>
    constexpr ArrayView(const T (&arr)[N]) noexcept : ptr(&arr[0]), count(N) {}
    constexpr const T *data() const noexcept { return ptr; }
    constexpr std::size_t size() const noexcept { return count; }
    constexpr std::size_t size_bytes() const noexcept { return count * sizeof(T); }
};

// ── Strong handle types ──────────────────────────────────────────────────────
{% for ht in handle_types %}
struct {{ ht.name }} {
    GLuint id = 0;
    constexpr {{ ht.name }}() = default;
    constexpr explicit {{ ht.name }}(GLuint v) : id(v) {}
    constexpr explicit operator bool() const { return id != 0; }
    friend constexpr bool operator==(const {{ ht.name }}& a, const {{ ht.name }}& b) { return a.id == b.id; }
    friend constexpr bool operator!=(const {{ ht.name }}& a, const {{ ht.name }}& b) { return a.id != b.id; }
};
{% endfor %}

// ── Location types ───────────────────────────────────────────────────────────
{% for lt in location_types %}
struct {{ lt.name }} {
    GLint loc = -1;
    constexpr {{ lt.name }}() = default;
    constexpr explicit {{ lt.name }}(GLint v) : loc(v) {}
    constexpr bool valid() const { return loc >= 0; }
};
{% endfor %}

// ── Flags template for bitmask enums ─────────────────────────────────────────
template <typename E>
class Flags {
public:
    constexpr Flags() = default;
    constexpr Flags(E e) : bits_(static_cast<GLbitfield>(e)) {}
    constexpr explicit Flags(GLbitfield v) : bits_(v) {}
    constexpr GLbitfield value() const { return bits_; }
    constexpr Flags operator|(Flags rhs) const { return Flags{static_cast<GLbitfield>(bits_ | rhs.bits_)}; }
    constexpr Flags& operator|=(Flags rhs) { bits_ |= rhs.bits_; return *this; }
private:
    GLbitfield bits_ = 0;
};

// ── Enum classes ─────────────────────────────────────────────────────────────
{% for ec in enum_classes %}
enum class {{ ec.group_name }} : {{ ec.base_type }} {
{% for entry in ec.entries %}
    {{ entry.name }} = {{ entry.value }}{% if not loop.is_last %},{% endif %}{% if existsIn(entry, "comment") %} /**< {{ entry.comment }} */{% endif %}

{% endfor %}
};
{% if ec.is_bitmask %}
constexpr Flags<{{ ec.group_name }}> operator|({{ ec.group_name }} a, {{ ec.group_name }} b) {
    return Flags<{{ ec.group_name }}>{a} | Flags<{{ ec.group_name }}>{b};
}
{% endif %}
{% endfor %}

