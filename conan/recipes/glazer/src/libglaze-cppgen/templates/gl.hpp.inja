{% endfor %}
 */
{% endif %}
struct {{ fn.struct_name }} {
{% for ov in fn.overloads %}
{% if ov.is_template_overload %}
    template <typename T>
{% endif %}
    inline {{ ov.return_type }} operator()({{ ov.params_str }}) const {
{{ ov.body }}
    }
{% endfor %}
    explicit operator bool() const { return {{ fn.raw_ptr }} != nullptr; }
};
inline {{ fn.struct_name }} {{ fn.func_name }}{};
#endif
{% if fn.has_extension_guard %}
#endif
{% endif %}
{% endfor %}

// ── DSA classes ──────────────────────────────────────────────────────────────
namespace dsa {
{% for dc in dsa_classes %}
class {{ dc.class_name }} {
public:
    ::{{ api }}::{{ dc.handle_type }} m_id;
    {{ dc.class_name }}() = default;
    explicit {{ dc.class_name }}(::{{ api }}::{{ dc.handle_type }} id) : m_id(id) {}

{% for m in dc.methods %}
#if GLAZE_GL_VERSION >= {{ m.version_int }}
{% if m.has_doc_brief %}
    /**
     * @brief {{ m.doc_brief }}
{% for p in m.doc_params %}
     * @param {{ p.name }} {{ p.desc }}
{% endfor %}
     */
{% endif %}
    inline {{ m.return_type }} {{ m.name }}({{ m.params_str }}) const {
{% if m.is_void_return %}
        {{ m.raw_ptr }}({{ m.call_args_str }});
{% else %}
        return {{ m.raw_ptr }}({{ m.call_args_str }});
{% endif %}
    }
#endif
{% endfor %}
};
{% endfor %}
} // namespace dsa

// ── RAII Traits specializations for strong handle types ─────────────────────
} // namespace {{ api }}

namespace glaze {
{% for r in raii_resources %}
#if GLAZE_GL_VERSION >= {{ r.version_int }}
template <>
struct Traits<{{ api }}::{{ r.handle_type }}> {
    static {{ api }}::{{ r.handle_type }} create({{ r.create_params_str }}) {
        return {{ api }}::{{ r.gen_func_name }}({{ r.create_call_args_str }});
    }
    static void destroy({{ api }}::{{ r.handle_type }}& v) { {{ api }}::{{ r.delete_func_name }}(v); }
    static bool valid(const {{ api }}::{{ r.handle_type }}& v) { return static_cast<bool>(v); }
};
#endif
{% endfor %}
} // namespace glaze

