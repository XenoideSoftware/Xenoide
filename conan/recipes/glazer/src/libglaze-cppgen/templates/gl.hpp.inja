namespace exts {
{% for ext in extensions %}
#ifndef {{ ext.guard_macro }}
inline bool {{ ext.short_name }}() { return ::{{ ext.flag_var }} != 0; }
#endif
{% endfor %}
} // namespace exts

// ── Functors ─────────────────────────────────────────────────────────────────
