@startuml xenoshader-process-architecture
'
' Xenoshader — C4 Container Diagram
'
' Requires the C4-PlantUML library:
'   https://github.com/plantuml-stdlib/C4-PlantUML
'
' Render with the PlantUML VS Code extension, IntelliJ plugin,
' or the online server at https://www.plantuml.com/plantuml
'

!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()

title Xenoshader — Process Architecture (C4 Container)

Person(dev, "Developer", "Writes, compiles, and debugs GLSL shaders.")

System_Boundary(sys, "Xenoshader") {

    Container(gui, "xenoshader", "Qt 6 / C++20",
        "SDI GUI client.\nHosts the code editor, docked panels,\nActionRegistry, and the Application State Machine.")

    ContainerDb(msgbus, "xenoide-msgbus", "ZeroMQ + Protocol Buffers",
        "Message bus.\nRoutes Commands via PUSH/PULL (one consumer).\nBroadcasts Events via PUB/SUB (all subscribers).\nThe only component that directly depends on ZeroMQ and protobuf.")

    Container(langserver, "xenoshader-langserver", "C++20 / glslang / LSP",
        "GLSL Language Server.\nEmbeds glslang for compilation.\nExposes LSP for editor intelligence (hover, go-to-declaration).\nResolves #include search paths per project.\nEmits compilation results and DiagnosticItems.")

    Container(rdoc, "xenoshader-rdoc", "C++20 / RenderDoc API",
        "RenderDoc integration service.\nManages GPU capture and replay sessions.\nVendor-neutral (Intel, NVIDIA, AMD).\nEmits debug lifecycle events.")

    Container(fswatcher, "xenoshader-fswatcher", "C++20 / native OS APIs",
        "Filesystem watcher service.\nMonitors the currently open file for on-disk changes.\nEmits file.conflict_detected when a conflict is detected.")
}

Rel(dev, gui, "Edits shaders, triggers Actions\n(menu, toolbar, keybindings)")

Rel(gui,        msgbus, "Sends Commands",                        "PUSH — cmd.*")
Rel(msgbus,     gui,    "Delivers Events",                       "SUB  — file.*, compilation.*, debug.*")

Rel(langserver, msgbus, "Subscribes to compile commands;\npublishes diagnostics and compilation events", "PULL cmd.shader.compile\nPUB  compilation.*, diagnostics.*")

Rel(rdoc,       msgbus, "Subscribes to debug commands;\npublishes debug lifecycle events",               "PULL cmd.debug.*\nPUB  debug.*")

Rel(fswatcher,  msgbus, "Publishes file conflict events",        "PUB  file.conflict_detected")

@enduml
